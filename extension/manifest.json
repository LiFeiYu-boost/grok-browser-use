{
  "manifest_version": 3,
  "name": "grok-browser-use",
  "version": "0.6.0",
  "description": "Lets Grok operate Chrome tabs in a dedicated tab group with a visible pointer.",
  "key": "",
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["pointer.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
